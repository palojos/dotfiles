/* =========================================================================
   ROFI CATPPUCCIN MOCHA THEME 
   ========================================================================= */

* {
    /* Palette Maps */
    bg-col:      #1e1e2e; /* Base */
    bg-alt:      #313244; /* Surface0 */
    border-col:  #cba6f7; /* Mauve */
    text-col:    #cdd6f4; /* Text */
    text-sel:    #11111b; /* Crust */
    accent-col:  #89b4fa; /* Blue */

    background-color:    transparent;
    text-color:          @text-col;
    font:                "JetBrains Mono Nerd Font 11";
}

window {
    background-color:     @bg-col;
    border:               2px;
    border-color:         @border-col;
    border-radius:        12px;
    width:                600px;
    padding:              20px;
}

mainbox {
    children:             [ inputbar, listview ];
}

inputbar {
    background-color:     @bg-alt;
    border-radius:        8px;
    padding:              10px;
    margin:               0px 0px 15px 0px;
    children:             [ prompt, entry ];
}

prompt {
    background-color:     @accent-col;
    text-color:           @text-sel;
    font:                 "JetBrains Mono Nerd Font Bold 11";
    border-radius:        6px;
    padding:              2px 10px;
    margin:               0px 10px 0px 0px;
}

entry {
    placeholder:          "Search...";
    placeholder-color:    #585b70;
    text-color:           @text-col;
}

listview {
    border:               0px;
    columns:              1;
    lines:                8;
    fixed-height:         true;
    scrollbar:            false;
}

element {
    padding:              8px;
    border-radius:        6px;
    spacing:              10px;
}

element normal text, element alternate text {
    text-color:           @text-col;
}

element selected {
    background-color:     @border-col; /* Highlights matching focused mauve items */
}

element selected text {
    text-color:           @text-sel;
    font:                 "JetBrains Mono Nerd Font Bold 11";
}

element-icon {
    size:                 24px; /* Crisp desktop standard sizing */
    cursor:               inherit;
}

element-text {
    cursor:               inherit;
    vertical-align:       0.5;
}

/* Ensure the text color flips correctly when highlighted */
element selected text, element selected icon {
    text-color:           @text-sel;
}
